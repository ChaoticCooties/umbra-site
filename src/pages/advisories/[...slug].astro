---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
export async function getStaticPaths() {
  const advisories = (await getCollection('advisories')).filter((entry) => entry.data.status === 'Disclosed');
  return advisories.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
type Props = { entry: CollectionEntry<'advisories'> };
const { entry } = Astro.props as Props;
const d = entry.data;
const { Content, headings } = await entry.render();
const fmt = (x: Date) => x.toISOString().slice(0, 10);
const recordId = d.cve ?? d.identifier ?? `UMB-${fmt(d.date).replaceAll('-', '')}-${entry.slug.toUpperCase()}`;
const sections = headings.filter((heading) => heading.depth === 2);
---
<Base title={`${d.title} — Project Umbra`} description={d.summary}>
  <article class="wrap advisory-record">
    <header class="advisory-header">
      <a class="back-link" href="/"><Arrow direction="left" /> All disclosures</a>
      <h1>{d.title}</h1>
      <p class="advisory-abstract">{d.summary}</p>
      <dl class="advisory-meta">
        <div><dt>Affected software</dt><dd>{d.vendor}{d.product ? ` / ${d.product}` : ''}</dd></div>
        <div><dt>Published</dt><dd><time datetime={fmt(d.date)}>{fmt(d.date)}</time></dd></div>
        <div><dt>Identifier</dt><dd class="identifier">{recordId}</dd></div>
        <div><dt>Severity</dt><dd class={`severity ${d.severity}`}>{d.severity}</dd></div>
      </dl>
    </header>
    <div class="reading-layout">
      <aside class="reading-nav advisory-nav" aria-label="Advisory navigation">
        {sections.length > 0 && <nav aria-label="In this advisory"><p class="nav-title">In this advisory</p>{sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}
        <dl class="case-details"><div><dt>Vulnerability class</dt><dd>{d.class}</dd></div><div><dt>Disclosure status</dt><dd>{d.status}</dd></div></dl>
        {d.link && <a class="text-link external-record" href={d.link} target="_blank" rel="noopener noreferrer">External record <Arrow direction="external" /><span class="sr-only"> (opens in a new tab)</span></a>}
        <a class="policy-link" href="/about#policy">Our disclosure policy</a>
      </aside>
      <div class="prose"><Content /></div>
    </div>
    <div class="article-end"><a class="text-link" href="/"><Arrow direction="left" /> Back to disclosures</a></div>
  </article>
</Base>
