---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
const advisories = (await getCollection('advisories'))
  .filter((entry) => entry.data.status === 'Disclosed')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...earlier] = advisories;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const ids = (a: (typeof advisories)[number]) => (a.data.cve ?? a.data.identifier ?? '').split(/,\s*/).filter(Boolean);
const target = (a: (typeof advisories)[number]) => `${a.data.vendor}${a.data.product ? ` / ${a.data.product}` : ''}`;
---
<Base title="Project Umbra — Disclosures">
  <div class="wrap">
    <h1 class="sr-only">Project Umbra disclosures</h1>
    {latest ? (
      <article class="feature">
        <a class="feature-link" href={`/advisories/${latest.slug}`} aria-labelledby={`title-${latest.slug}`}>
          <h2 id={`title-${latest.slug}`} class="feature-title">{latest.data.title}</h2>
          <div class="feature-body">
            <div class="feature-summary">
              <p>{latest.data.summary}</p>
              <span class="feature-action">Read advisory <Arrow /></span>
            </div>
            <dl class="feature-facts">
              <div><dt>Target</dt><dd>{target(latest)}</dd></div>
              <div><dt>Severity</dt><dd class={`severity ${latest.data.severity}`}>{latest.data.severity}</dd></div>
              {(latest.data.cve ?? latest.data.identifier) && <div><dt>Identifier</dt><dd class="identifier">{ids(latest).map((id, i) => <>{i > 0 && ', '}<span>{id}</span></>)}</dd></div>}
              <div><dt>Published</dt><dd><time datetime={fmt(latest.data.date)}>{fmt(latest.data.date)}</time></dd></div>
            </dl>
          </div>
        </a>
      </article>
    ) : (
      <p class="empty-state">No public advisories yet. Findings appear here once disclosure is coordinated.</p>
    )}
    {earlier.length > 0 && (
      <section class="disclosures" aria-labelledby="earlier-title">
        <header class="column-heads">
          <h2 id="earlier-title">Earlier advisories</h2>
          <span aria-hidden="true">Summary</span>
          <span aria-hidden="true">Published</span>
        </header>
        <div class="research-list">
          {earlier.map((a) => (
            <article class="research-record">
              <a class="research-link" href={`/advisories/${a.slug}`} aria-labelledby={`title-${a.slug}`}>
                <div class="record-title"><h3 id={`title-${a.slug}`}>{a.data.title}</h3><span class="record-target">{target(a)}</span></div>
                <div class="record-summary"><p>{a.data.summary}</p><span class="identifier">{ids(a).length ? ids(a).map((id, i) => <>{i > 0 && ', '}<span>{id}</span></>) : a.data.class}</span></div>
                <div class="record-meta"><time datetime={fmt(a.data.date)}>{fmt(a.data.date)}</time><span class={`severity ${a.data.severity}`}>{a.data.severity}<span class="sr-only"> severity</span></span></div>
                <span class="record-action">Read advisory <Arrow /></span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
    <div class="ledger-end">
      <p>Project Umbra is an AI security experiment. Each advisory is published after the vendor has had a chance to fix it.</p>
      <a class="text-link" href="/about#policy">Disclosure policy <Arrow /></a>
    </div>
  </div>
</Base>
