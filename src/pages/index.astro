---
import Base from '../layouts/Base.astro';
import { disclosedAdvisories, identifiers, isoDate, leadSentence } from '../lib/advisories';

const advisories = await disclosedAdvisories();
const years = [...new Set(advisories.map((a) => a.data.date.getUTCFullYear()))];
---
<Base title="Project Umbra — Disclosure archive">
  <div class="wrap">
    <header class="page-head">
      <h1>Disclosure archive</h1>
      <p>Advisories from Project Umbra, an AI security experiment. Each one is published after the vendor has had a chance to fix the issue. <a href="/about#policy">Disclosure policy</a></p>
    </header>
    {advisories.length === 0 && <p class="empty">No advisories are public yet. Each one appears here after its disclosure is coordinated.</p>}
    {years.map((year) => {
      const rows = advisories.filter((a) => a.data.date.getUTCFullYear() === year);
      return (
        <section class="year" aria-labelledby={`year-${year}`}>
          <h2 class="year-line" id={`year-${year}`}>{year} · {rows.length} {rows.length === 1 ? 'advisory' : 'advisories'}</h2>
          <table class="register">
            <thead>
              <tr><th class="c-date" scope="col">Date</th><th class="c-sev" scope="col">Severity</th><th scope="col">Subject</th><th class="c-id" scope="col">Identifier</th></tr>
            </thead>
            <tbody>
              {rows.map((a) => (
                <tr>
                  <td class="r-date"><time datetime={isoDate(a.data.date)}>{isoDate(a.data.date)}</time></td>
                  <td class="r-sev"><span class={`sev ${a.data.severity}`}>{a.data.severity}</span></td>
                  <td class="r-subject"><a href={`/advisories/${a.slug}`}>{a.data.title}</a><p>{a.data.lede ?? leadSentence(a.data.summary)}</p></td>
                  <td class="r-id">{identifiers(a).length ? identifiers(a).map((id) => <span class="mono">{id}</span>) : <span>{a.data.class}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      );
    })}
  </div>
</Base>
