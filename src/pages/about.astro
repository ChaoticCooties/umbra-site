---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SectionNav from '../components/SectionNav.astro';
const sections = [
  { href: '#mandate', text: 'Mandate' },
  { href: '#policy', text: 'Coordinated disclosure' },
  { href: '#team', text: 'Team' },
];
---
<Base title="About — Project Umbra">
  <div class="wrap reading">
  <SectionNav title="About Umbra" items={sections} />
  <div class="about">
    <header class="page-head">
      <h1>About Project Umbra</h1>
      <p>An independent group investigating software supply chains and memory safety with agentic LLM systems and manual review.</p>
    </header>
    <section id="mandate" aria-labelledby="mandate-title">
      <h2 id="mandate-title">Mandate</h2>
      <p>An AI security experiment. For the background, see <a href="https://cooties.io/blog/project-umbra/" target="_blank" rel="noopener noreferrer">Project Umbra</a>.</p>
      <p>Findings are published here only once the vendor has had a chance to fix.</p>
    </section>
    <section id="policy" aria-labelledby="policy-title">
      <h2 id="policy-title">Coordinated disclosure</h2>
      <p>We report issues privately to the affected vendor and give them <strong>90 days</strong> to ship a fix before anything is published. The clock starts on first contact.</p>
      <p>If a vendor responds quickly, asks for more time in good faith, or the issue is already being exploited in the wild, we adjust the timeline accordingly. Technical detail stays embargoed until disclosure.</p>
    </section>
    <section id="team" aria-labelledby="team-title">
      <h2 id="team-title">Team</h2>
      <table class="team">
        <thead><tr><th scope="col">Name</th><th scope="col">Role</th></tr></thead>
        <tbody>
          <tr><td><a href="https://www.linkedin.com/in/joechegne/" target="_blank" rel="noopener noreferrer">Eu Joe <Arrow direction="external" /><span class="sr-only"> (LinkedIn, opens in a new tab)</span></a></td><td>Model, evals, pipeline</td></tr>
          <tr><td><a href="https://www.linkedin.com/in/supertsumu/" target="_blank" rel="noopener noreferrer">Damien Wong <Arrow direction="external" /><span class="sr-only"> (LinkedIn, opens in a new tab)</span></a></td><td>Triage, manual review</td></tr>
          <tr><td><a href="https://www.linkedin.com/in/the-olivier-gagne/" target="_blank" rel="noopener noreferrer">Olivier Gagné <Arrow direction="external" /><span class="sr-only"> (LinkedIn, opens in a new tab)</span></a></td><td>Triage, manual review</td></tr>
        </tbody>
      </table>
    </section>
  </div>
  </div>
</Base>
